<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/border"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="2dp"
            android:contentDescription="@string/Item_image"
            android:scaleType="fitXY"
            android:src="@drawable/ic_manech_logo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/colorAccent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:textColor="@color/colorAccent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvItemCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgHighlight"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="4dp"
                android:background="@drawable/border3"
                android:contentDescription="@string/highlight"
                android:padding="6dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_highlight" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/trash_actions_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/border3"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/imgRestore"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Restore"
                    android:padding="6dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_restore" />

                <ImageView
                    android:id="@+id/imgDeleteForever"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Delete forever"
                    android:padding="6dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_delete_forever" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/active_actions_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/border3"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgDuplicate"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Duplicate"
                    android:padding="6dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_copy" />

                <ImageView
                    android:id="@+id/imgTrash"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Trash"
                    android:padding="6dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_delete" />

                <ImageView
                    android:id="@+id/imgJoin"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Join store"
                    android:padding="6dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_join"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgPublish"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Share"
                    android:padding="6dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_share" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>